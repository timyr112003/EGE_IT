[Unit]
Description=Urok Python - сайт урока (Next.js, порт 3000)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/urok
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
ExecStart=/usr/local/bin/bun .next/standalone/server.js
Restart=always
RestartSec=3
StandardOutput=append:/var/log/urok-web.log
StandardError=append:/var/log/urok-web.err.log

[Install]
WantedBy=multi-user.target
